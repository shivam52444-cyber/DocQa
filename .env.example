# ---------- backend (api + worker) ----------
ENV=prod
LOG_LEVEL=INFO
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/docqa?sslmode=require
S3_BUCKET=your-docqa-bucket
AWS_REGION=us-east-1

# Llama through any OpenAI-compatible host (Together, Groq, Fireworks, vLLM...)
LLAMA_BASE_URL=https://api.together.xyz/v1
LLAMA_API_KEY=
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

INTERNAL_API_TOKEN=            # optional shared secret, same value in the frontend

# LangSmith (tracing). Hide inputs/outputs so user documents never leave your account.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docqa-backend
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# ---------- frontend ----------
BACKEND_URL=http://internal-backend-alb-dns
# INTERNAL_API_TOKEN=            # must match the backend value
